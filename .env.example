# Supabase — para o browser (Vite). Project Settings → API: URL + anon (public).
# Obrigatório para login por email (link mágico) e para ler/gravar a tabela `albums` com RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: em dev, proxy de /api (só se tiveres rotas serverless locais)
# VITE_API_BASE=http://127.0.0.1:3000
